<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>
        <TargetFrameworks>net8.0;net6.0;net7.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Notifliwy.Units"/>
        <InternalsVisibleTo Include="Notifliwy.Benchmark"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Notifliwy.Hosting"/>
        <InternalsVisibleTo Include="Notifliwy.OpenTelemetry.Instrumentation"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Notifliwy.Provider.MassTransit.Kafka"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Notifliwy.Sample.Kafka.Server"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\generators\Notifliwy.Generators\Notifliwy.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- embed the sector registration source generator into the package analyzers slot,
         so downstream consumers of Notifliwy get [NotifliwySectors] generation with no extra reference -->
    <PropertyGroup>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);PackNotifliwySectorGenerator</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <Target Name="PackNotifliwySectorGenerator" DependsOnTargets="ResolveReferences">
        <ItemGroup>
            <TfmSpecificPackageFile Include="..\..\generators\Notifliwy.Generators\bin\$(Configuration)\netstandard2.0\Notifliwy.Generators.dll"
                                    PackagePath="analyzers/dotnet/cs/Notifliwy.Generators.dll"/>
        </ItemGroup>
    </Target>

    <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
        <PackageReference Include="Microsoft.Extensions.Options" Version="6.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="6.0.0"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net7.0'">
        <PackageReference Include="Microsoft.Extensions.Options" Version="7.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="7.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="7.0.0"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\..\contents\icon.main.png">
            <Pack>True</Pack>
            <PackagePath/>
            <Link>icon.main.png</Link>
        </None>
    </ItemGroup>

    <PropertyGroup>
        <Version>3.2.0</Version>
        <FileVersion>$(Version)</FileVersion>
        <AssemblyVersion>$(Version)</AssemblyVersion>
    </PropertyGroup>

    <PropertyGroup>
        <PackageIcon>icon.main.png</PackageIcon>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageTags>notifliwy, notification, event, handler, connector, condition</PackageTags>
    </PropertyGroup>

    <PropertyGroup>
        <Description>.NET library for distributed handler and pipeline for notifications</Description>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\..\..\README.md">
            <Link>README.md</Link>
            <Pack>True</Pack>
            <PackagePath/>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Exporters\Interfaces\Options\"/>
        <Folder Include="Options\"/>
    </ItemGroup>

    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

</Project>