<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- single netstandard2.0 target: the analyzers/dotnet slot loads on every consumer,
             .NET Framework included, and keeps GeneratePackageOnBuild pack paths unambiguous -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <IsPackable>true</IsPackable>

        <!-- analyzer-style package: no lib output, packed into analyzers/ -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
        <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    </PropertyGroup>

    <PropertyGroup>
        <Version>3.2.0</Version>
        <FileVersion>$(Version)</FileVersion>
        <AssemblyVersion>$(Version)</AssemblyVersion>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Notifliwy sector registration source generator: [NotifliwySectors] emits AddNotifliwySectors() with zero runtime reflection</Description>
        <PackageTags>notifliwy, notification, source-generator, sectors, analyzer</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    </ItemGroup>

    <!-- pack the analyzer assembly into the package analyzers slot (IncludeBuildOutput keeps lib/ empty);
         TargetPath is only reliable at pack time, so the file is attached via the documented
         TfmSpecificContentInPackage hook instead of an evaluation-time None item -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackNotifliwyAnalyzerOutputs</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="PackNotifliwyAnalyzerOutputs"
            Returns="@(TfmSpecificPackageFile)">
        <ItemGroup>
            <!-- explicit project-relative path: TargetPath is not set inside the pack inner-dispatch node;
                 the item name matches what _GetTfmSpecificContentForPackage consumes on this SDK -->
            <TfmSpecificPackageFile Include="bin\$(Configuration)\netstandard2.0\$(AssemblyName).dll"
                                    PackagePath="analyzers/dotnet/cs/$(AssemblyName).dll"/>
        </ItemGroup>
    </Target>

</Project>
